import { TextEdit, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    in-out property <string> decoded <=> decoded-edit.text;
    in-out property <string> encoded <=> encoded-edit.text;
    in property <string> status;
    in property <string> transform;
    callback decoded-edited(string);
    callback encoded-edited(string);

    title: "fast-codec";
    icon: @image-url("../assets/icon.svg");
    preferred-width: 640px;
    preferred-height: 400px;
    forward-focus: decoded-edit;

    VerticalBox {
        Text { text: "Decoded"; }
        decoded-edit := TextEdit {
            edited(text) => { root.decoded-edited(text); }
        }
        Text { text: "Encoded (\{root.transform})"; }
        encoded-edit := TextEdit {
            edited(text) => { root.encoded-edited(text); }
        }
        Text { text: root.status; }
    }
}
